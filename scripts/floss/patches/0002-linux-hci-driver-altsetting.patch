+bool switch_linux_hci_driver_altsetting(uint8_t altsetting) {
+  // Linux 6.18 HCI_DRV_PKT command header: opcode 0x0401, payload length 1.
+  // Opcode 0x0401 is btusb's driver-specific Switch Altsetting command.
+  std::vector<uint8_t> command = {0x01, 0x04, 0x01, 0x00, altsetting};
+  auto* hci_hal = bluetooth::shim::GetHciHal();
+  return hci_hal != nullptr && hci_hal->sendHciDriverCommand(std::move(command));
+}
