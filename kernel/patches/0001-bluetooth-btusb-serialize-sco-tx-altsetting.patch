From: Dorsche Project <dorsche@localhost>
Date: Wed, 16 Sep 2026 21:15:00 +0000
Subject: [PATCH] Bluetooth: btusb: serialize SCO TX with altsetting changes

SCO TX URBs use endpoint descriptors owned by the currently selected USB
alternate setting.  btusb kills the receive anchor before changing that
setting, but SCO transmit URBs share tx_anchor with command and ACL traffic
and remain live. A concurrent or final SCO write can therefore be submitted
after usb_set_interface() disables the old endpoint, producing EMSGSIZE.

Give SCO TX its own anchor and serialize endpoint lookup, URB construction,
submission, cancellation, and alternate-setting changes with a per-device
mutex.  Keep command, ACL, and ISO data on the existing TX path.  Route the
native SCO disconnect path through the same serialized switch helper and
accept alternate setting zero, which intentionally has no isochronous
endpoints.

Tested on upstream Linux 6.18.15 with a CSR 0a12:0001 controller and
UGREEN HiTune T3. Repeated 48-byte mSBC and CVSD full-duplex runs
transitioned the USB interface back to altsetting zero without the former
"submission failed (90)" message.
---
 drivers/bluetooth/btusb.c | 94 ++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 77 insertions(+), 17 deletions(-)

diff --git a/drivers/bluetooth/btusb.c b/drivers/bluetooth/btusb.c
index a953fa9af..27b1ea404 100644
--- a/drivers/bluetooth/btusb.c
+++ b/drivers/bluetooth/btusb.c
@@ -12,6 +12,7 @@
 #include <linux/usb/quirks.h>
 #include <linux/firmware.h>
 #include <linux/iopoll.h>
+#include <linux/mutex.h>
 #include <linux/of_device.h>
 #include <linux/of_irq.h>
 #include <linux/suspend.h>
@@ -922,6 +923,9 @@ struct btusb_data {
 
 	struct usb_anchor deferred;
 	struct usb_anchor tx_anchor;
+	struct usb_anchor isoc_tx_anchor;
+	/* Protects the isoc TX endpoint and anchor across altsetting changes. */
+	struct mutex isoc_tx_mutex;
 	int tx_in_flight;
 	spinlock_t txlock;
 
@@ -1977,6 +1980,10 @@ static void btusb_stop_traffic(struct btusb_data *data)
 	usb_kill_anchored_urbs(&data->isoc_anchor);
 	usb_kill_anchored_urbs(&data->diag_anchor);
 	usb_kill_anchored_urbs(&data->ctrl_anchor);
+
+	mutex_lock(&data->isoc_tx_mutex);
+	usb_kill_anchored_urbs(&data->isoc_tx_anchor);
+	mutex_unlock(&data->isoc_tx_mutex);
 }
 
 static int btusb_close(struct hci_dev *hdev)
@@ -2028,6 +2035,9 @@ static int btusb_flush(struct hci_dev *hdev)
 	skb_queue_purge(&data->acl_q);
 
 	usb_kill_anchored_urbs(&data->tx_anchor);
+	mutex_lock(&data->isoc_tx_mutex);
+	usb_kill_anchored_urbs(&data->isoc_tx_anchor);
+	mutex_unlock(&data->isoc_tx_mutex);
 	btusb_free_frags(data);
 
 	return 0;
@@ -2144,6 +2154,47 @@ static int submit_tx_urb(struct hci_dev *hdev, struct urb *urb)
 	return err;
 }
 
+static int submit_isoc_tx_urb(struct hci_dev *hdev, struct sk_buff *skb)
+{
+	struct btusb_data *data = hci_get_drvdata(hdev);
+	struct urb *urb;
+	int err;
+
+	mutex_lock(&data->isoc_tx_mutex);
+
+	/* Serialize both URB construction and submission with alternate-setting
+	 * changes. The endpoint descriptor and its maximum packet size belong
+	 * to the currently selected alternate setting.
+	 */
+	if (!test_bit(BTUSB_ISOC_RUNNING, &data->flags)) {
+		err = -ENODEV;
+		goto unlock;
+	}
+
+	urb = alloc_isoc_urb(hdev, skb);
+	if (IS_ERR(urb)) {
+		err = PTR_ERR(urb);
+		goto unlock;
+	}
+
+	usb_anchor_urb(urb, &data->isoc_tx_anchor);
+
+	err = usb_submit_urb(urb, GFP_KERNEL);
+	if (err < 0) {
+		if (err != -EPERM && err != -ENODEV)
+			bt_dev_err(hdev, "urb %p submission failed (%d)",
+				   urb, -err);
+		usb_unanchor_urb(urb);
+	} else {
+		usb_mark_last_busy(data->udev);
+	}
+
+	usb_free_urb(urb);
+unlock:
+	mutex_unlock(&data->isoc_tx_mutex);
+	return err;
+}
+
 static int submit_or_queue_tx_urb(struct hci_dev *hdev, struct urb *urb)
 {
 	struct btusb_data *data = hci_get_drvdata(hdev);
@@ -2194,12 +2245,8 @@ static int btusb_send_frame(struct hci_dev *hdev, struct sk_buff *skb)
 		    hci_conn_num(hdev, SCO_LINK) < 1)
 			return -ENODEV;
 
-		urb = alloc_isoc_urb(hdev, skb);
-		if (IS_ERR(urb))
-			return PTR_ERR(urb);
-
 		hdev->stat.sco_tx++;
-		return submit_tx_urb(hdev, urb);
+		return submit_isoc_tx_urb(hdev, skb);
 
 	case HCI_ISODATA_PKT:
 		urb = alloc_bulk_urb(hdev, skb);
@@ -2260,6 +2307,10 @@ static inline int __set_isoc_interface(struct hci_dev *hdev, int altsetting)
 		}
 	}
 
+	/* Alternate setting zero intentionally has no isochronous endpoints. */
+	if (altsetting == 0)
+		return 0;
+
 	if (!data->isoc_tx_ep || !data->isoc_rx_ep) {
 		bt_dev_err(hdev, "invalid SCO descriptors");
 		return -ENODEV;
@@ -2271,13 +2322,16 @@ static inline int __set_isoc_interface(struct hci_dev *hdev, int altsetting)
 static int btusb_switch_alt_setting(struct hci_dev *hdev, int new_alts)
 {
 	struct btusb_data *data = hci_get_drvdata(hdev);
-	int err;
+	int err = 0;
+
+	mutex_lock(&data->isoc_tx_mutex);
 
 	if (data->isoc_altsetting != new_alts) {
 		unsigned long flags;
 
 		clear_bit(BTUSB_ISOC_RUNNING, &data->flags);
 		usb_kill_anchored_urbs(&data->isoc_anchor);
+		usb_kill_anchored_urbs(&data->isoc_tx_anchor);
 
 		/* When isochronous alternate setting needs to be
 		 * changed, because SCO connection has been added
@@ -2295,7 +2349,14 @@ static int btusb_switch_alt_setting(struct hci_dev *hdev, int new_alts)
 
 		err = __set_isoc_interface(hdev, new_alts);
 		if (err < 0)
-			return err;
+			goto done;
+	}
+
+	if (new_alts == 0) {
+		clear_bit(BTUSB_ISOC_RUNNING, &data->flags);
+		usb_kill_anchored_urbs(&data->isoc_anchor);
+		usb_kill_anchored_urbs(&data->isoc_tx_anchor);
+		goto done;
 	}
 
 	if (!test_and_set_bit(BTUSB_ISOC_RUNNING, &data->flags)) {
@@ -2305,7 +2366,9 @@ static int btusb_switch_alt_setting(struct hci_dev *hdev, int new_alts)
 			btusb_submit_isoc_urb(hdev, GFP_KERNEL);
 	}
 
-	return 0;
+done:
+	mutex_unlock(&data->isoc_tx_mutex);
+	return err;
 }
 
 static struct usb_host_interface *btusb_find_altsetting(struct btusb_data *data,
@@ -2377,10 +2440,8 @@ static void btusb_work(struct work_struct *work)
 		if (btusb_switch_alt_setting(hdev, new_alts) < 0)
 			bt_dev_err(hdev, "set USB alt:(%d) failed!", new_alts);
 	} else {
-		usb_kill_anchored_urbs(&data->isoc_anchor);
-
-		if (test_and_clear_bit(BTUSB_ISOC_RUNNING, &data->flags))
-			__set_isoc_interface(hdev, 0);
+		if (btusb_switch_alt_setting(hdev, 0) < 0)
+			bt_dev_err(hdev, "set USB alt:(0) failed!");
 
 		if (test_and_clear_bit(BTUSB_DID_ISO_RESUME, &data->flags))
 			usb_autopm_put_interface(data->isoc ? data->isoc : data->intf);
@@ -2671,12 +2732,8 @@ static int btusb_send_frame_intel(struct hci_dev *hdev, struct sk_buff *skb)
 		    hci_conn_num(hdev, SCO_LINK) < 1)
 			return -ENODEV;
 
-		urb = alloc_isoc_urb(hdev, skb);
-		if (IS_ERR(urb))
-			return PTR_ERR(urb);
-
 		hdev->stat.sco_tx++;
-		return submit_tx_urb(hdev, urb);
+		return submit_isoc_tx_urb(hdev, skb);
 
 	case HCI_ISODATA_PKT:
 		urb = alloc_bulk_urb(hdev, skb);
@@ -4066,6 +4123,8 @@ static int btusb_probe(struct usb_interface *intf,
 
 	init_usb_anchor(&data->deferred);
 	init_usb_anchor(&data->tx_anchor);
+	init_usb_anchor(&data->isoc_tx_anchor);
+	mutex_init(&data->isoc_tx_mutex);
 	spin_lock_init(&data->txlock);
 
 	init_usb_anchor(&data->intr_anchor);
-- 
2.46.0
